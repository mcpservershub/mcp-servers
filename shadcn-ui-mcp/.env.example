# GitHub API Configuration
# Get your token from: https://github.com/settings/tokens
# Required scopes: public_repo (for public repositories)
GITHUB_API_KEY=ghp_your_github_token_here

# Framework Selection
# Options: react (default), vue, svelte, react-native
FRAMEWORK=react

# Node Environment
# Options: production (default), development
NODE_ENV=production

# Rate Limiting
# With GitHub token: 5000 requests/hour
# Without token: 60 requests/hour