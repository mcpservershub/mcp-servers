# Generated by https://smithery.ai. See: https://smithery.ai/docs/config#dockerfile
# Use a Node.js image as the base for building the application
FROM cgr.dev/chainguard/node:latest-dev AS builder

# Switch to root user temporarily to set up the working directory
USER root

# Set the working directory inside the container
WORKDIR /app

# Change ownership of the working directory to the node user
RUN chown -R node:node /app

# Switch back to the node user
USER node

# Copy package.json and package-lock.json to install dependencies
COPY --chown=node:node package.json ./

# Install dependencies (ignoring scripts to prevent running the prepare script)
RUN npm install --ignore-scripts

# Copy the rest of the application source code
COPY --chown=node:node . .

# Build the application using TypeScript
RUN npm run build

# Use a smaller Node.js image for the final image
FROM cgr.dev/chainguard/wolfi-base

# Install Node.js and npm
RUN apk update && apk add nodejs npm

# Create a non-root user for running the application
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# Set the working directory inside the container
WORKDIR /app

# Change ownership of the working directory to nodejs user
RUN chown -R nodejs:nodejs /app

# Copy the built application from the builder stage with proper ownership
COPY --from=builder --chown=nodejs:nodejs /app/dist /app/dist
COPY --from=builder --chown=nodejs:nodejs /app/package.json /app/package.json

# Switch to the nodejs user
USER nodejs

# Install only production dependencies
RUN npm install --omit=dev --ignore-scripts

# Accept API key as build argument (optional)
# Usage: docker build --build-arg FIRECRAWL_API_KEY=your_key -f Dockerfile.cgr -t image_name .
ARG FIRECRAWL_API_KEY

# Set environment variable from build arg if provided
# Priority order: runtime -e flag > build-arg > .env file
ENV FIRECRAWL_API_KEY=${FIRECRAWL_API_KEY}

# Specify the command to run the application
ENTRYPOINT ["node", "dist/index.js"]
