# Multi-stage Dockerfile for Tree-sitter MCP Server
# Stage 1: Builder - Install dependencies and build the package
FROM cgr.dev/chainguard/wolfi-base AS builder

# Set working directory
WORKDIR /build

# Install build dependencies including Rust for tree-sitter-graph
RUN apk update && apk add python-3.12 py3.12-pip build-base rust cargo

# Copy package files
COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install wheel
RUN pip install --upgrade pip wheel

# Install the package with all dependencies
# Using tree-sitter 0.20.4 for compatibility with tree-sitter-languages
RUN pip install -e .

# Install tree-sitter-graph CLI tool
RUN cargo install tree-sitter-graph --root /opt/tree-sitter-graph

# Stage 2: Runtime - Minimal image with only runtime requirements
FROM cgr.dev/chainguard/wolfi-base AS final

# Install runtime dependencies (graphviz for visualization and libgcc for tree-sitter-graph)
RUN apk update && apk add python-3.12 py3.12-pip graphviz graphviz-dev libgcc libstdc++

# Set working directory
WORKDIR /app

COPY languages/ ./languages

# Create non-root user for security
RUN addgroup mcp && adduser -D -G mcp mcp

# Create the tree-sitter config directory for mcp user
RUN mkdir -p /home/mcp/.config/tree-sitter && chown -R mcp:mcp /home/mcp/.config

# Copy the config.json file to the tree-sitter config directory
COPY --chown=mcp:mcp config.json /home/mcp/.config/tree-sitter/config.json

# Copy virtual environment from builder (includes installed package)
COPY --from=builder --chown=mcp:mcp /opt/venv /opt/venv

# Copy tree-sitter-graph binary from builder
COPY --from=builder --chown=mcp:mcp /opt/tree-sitter-graph/bin/tree-sitter-graph /usr/local/bin/tree-sitter-graph

# Copy the entire build directory which has the installed package
COPY --from=builder --chown=mcp:mcp /build /app

# Set environment variables
ENV PATH="/opt/venv/bin:/usr/local/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH="/app/src:$PYTHONPATH"

# Switch to non-root user
USER mcp

# # Verify installation
# RUN python -c "from treesitter_mcp_new.server import mcp; print('✓ MCP server loaded successfully')"

# Health check
# HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
#   CMD python -c "from treesitter_mcp_new.server import list_languages; import asyncio; asyncio.run(list_languages())" || exit 1
#
# # Labels
# LABEL maintainer="IntelOps.ai" \
#   description="Enhanced Tree-sitter MCP Server with graph visualization and code analysis" \
#   version="0.2.0" \
#   org.opencontainers.image.source="https://github.com/intelops/tree-sitter-mcp" \
#   org.opencontainers.image.description="MCP server for Tree-sitter parsing, visualization, and analysis" \
#   org.opencontainers.image.licenses="MIT"

# Default command - run the MCP server
ENTRYPOINT ["python", "-m"]
CMD ["treesitter_mcp_new.server"]