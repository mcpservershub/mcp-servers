# Firecrawl MCP Server Configuration

# Local Firecrawl API Configuration
# Point to your locally hosted Firecrawl instance
FIRECRAWL_API_URL=http://localhost:3002

# Optional: Set to 'local' for local development mode
# This will skip API key validation and cloud-specific features
FIRECRAWL_MODE=local

# Optional: Port for SSE mode (if using SSE instead of stdio)
# SSE_LOCAL=true
# PORT=3000

# Optional: Logging level (debug, info, warning, error)
LOGGING_LEVEL=info

# Optional: Retry configuration for rate limiting
FIRECRAWL_RETRY_MAX_ATTEMPTS=3
FIRECRAWL_RETRY_INITIAL_DELAY=1000
FIRECRAWL_RETRY_MAX_DELAY=10000
FIRECRAWL_RETRY_BACKOFF_FACTOR=2