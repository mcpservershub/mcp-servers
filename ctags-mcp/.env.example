# Universal CTags MCP Server Environment Variables

# Path to Universal CTags binary
CTAGS_BINARY=/usr/local/bin/ctags

# Workspace path to mount in Docker
WORKSPACE_PATH=./

# Tags cache directory path
TAGS_CACHE_PATH=./cache

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# MCP Server port (if applicable)
MCP_PORT=3000

# Maximum file size for indexing (in MB)
MAX_FILE_SIZE=50

# Cache TTL in seconds
CACHE_TTL=300

# Enable/disable caching
CACHE_ENABLED=true