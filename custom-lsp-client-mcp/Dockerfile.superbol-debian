# Multi-stage Dockerfile for MCP Server with SuperBOL COBOL support
# Uses Debian base for SuperBOL build for better compatibility

# Stage 1: Build SuperBOL using Debian
FROM debian:bookworm AS superbol-builder

# Install dependencies for SuperBOL build
RUN apt-get update && apt-get install -y \
    git \
    make \
    curl \
    nodejs \
    npm \
    opam \
    build-essential \
    pkg-config \
    libgmp-dev \
    m4 \
    unzip \
    bubblewrap \
    python3 \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Initialize opam
RUN opam init --disable-sandboxing -y && \
    eval $(opam env)

# Build SuperBOL from source
WORKDIR /opt

# Clone SuperBOL source
RUN git clone https://github.com/ocamlpro/superbol-studio-oss.git
WORKDIR /opt/superbol-studio-oss

# Install OCaml and essential build dependencies
RUN eval $(opam env) && \
    opam update && \
    opam install -y \
        ocaml \
        dune \
        menhir \
        ppx_deriving \
        ppx_import \
        yojson \
        lsp \
        jsonrpc \
        uri \
        re

# Try building SuperBOL LSP server
RUN eval $(opam env) && \
    echo "Building SuperBOL..." && \
    dune build --profile release 2>&1 | tee build.log || \
    echo "Build completed with potential issues, checking results..."

# Look for any SuperBOL binary and install it
RUN eval $(opam env) && \
    echo "Searching for SuperBOL binaries..." && \
    find _build -name "*superbol*" -type f -executable | head -10 && \
    find _build -name "*lsp*" -type f -executable | head -10 && \
    find _build -name "*cobol*" -type f -executable | head -10 && \
    SUPERBOL_BIN=$(find _build -name "*superbol*" -type f -executable | head -1) && \
    if [ -n "$SUPERBOL_BIN" ] && [ -f "$SUPERBOL_BIN" ]; then \
        echo "Found SuperBOL binary: $SUPERBOL_BIN" && \
        cp "$SUPERBOL_BIN" /usr/local/bin/superbol && \
        chmod +x /usr/local/bin/superbol; \
    else \
        echo "No SuperBOL binary found, checking for any LSP executables..." && \
        LSP_BIN=$(find _build -name "*lsp*" -type f -executable | head -1) && \
        if [ -n "$LSP_BIN" ] && [ -f "$LSP_BIN" ]; then \
            echo "Found LSP binary: $LSP_BIN" && \
            cp "$LSP_BIN" /usr/local/bin/superbol && \
            chmod +x /usr/local/bin/superbol; \
        else \
            echo "No LSP binaries found, checking for any COBOL executables..." && \
            COBOL_BIN=$(find _build -name "*cobol*" -type f -executable | head -1) && \
            if [ -n "$COBOL_BIN" ] && [ -f "$COBOL_BIN" ]; then \
                echo "Found COBOL binary: $COBOL_BIN" && \
                cp "$COBOL_BIN" /usr/local/bin/superbol && \
                chmod +x /usr/local/bin/superbol; \
            else \
                echo "No suitable binaries found, creating error binary" && \
                echo '#!/bin/sh' > /usr/local/bin/superbol && \
                echo 'echo "SuperBOL build failed - no binaries produced"' >> /usr/local/bin/superbol && \
                echo 'echo "Build log available in container"' >> /usr/local/bin/superbol && \
                echo 'exit 1' >> /usr/local/bin/superbol && \
                chmod +x /usr/local/bin/superbol; \
            fi \
        fi \
    fi

# Also copy build log for debugging
RUN cp build.log /usr/local/bin/superbol-build.log 2>/dev/null || echo "No build log to copy"

# Stage 2: Python runtime with MCP Server
FROM python:3.12-slim AS mcp-server

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy SuperBOL binary and build log from builder stage
COPY --from=superbol-builder /usr/local/bin/superbol /usr/local/bin/superbol
COPY --from=superbol-builder /usr/local/bin/superbol-build.log /usr/local/bin/superbol-build.log

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml ./
COPY src/ ./src/

# Install Python dependencies
RUN pip install --no-cache-dir -e .

# Create workspace and cache directories
RUN mkdir -p /workspace /cache

# Set environment variables
ENV WORKSPACE_ROOT=/workspace \
    MCP_LSP_CACHE_DIR=/cache \
    PYTHONUNBUFFERED=1 \
    SUPERBOL_PATH=/usr/local/bin/superbol \
    PATH="/usr/local/bin:${PATH}"

# Verify SuperBOL installation
RUN superbol --version || echo "SuperBOL installation verification failed"

# Default command to run the MCP server
CMD ["python", "-m", "multilspy_mcp.server"]