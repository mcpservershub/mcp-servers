# Minimal Debian-based Dockerfile for SuperBOL COBOL support
# Focus on essential dependencies only for faster builds

# Stage 1: Build SuperBOL using Debian
FROM debian:bookworm-slim AS superbol-builder

# Install only essential dependencies for SuperBOL build
RUN apt-get update && apt-get install -y \
    git \
    opam \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Initialize opam with minimal configuration
RUN opam init --disable-sandboxing -y

# Build SuperBOL from source
WORKDIR /opt
RUN git clone --depth 1 https://github.com/ocamlpro/superbol-studio-oss.git
WORKDIR /opt/superbol-studio-oss

# Install minimal OCaml dependencies and build
RUN eval $(opam env) && \
    opam update && \
    opam install -y dune ocaml && \
    echo "Attempting minimal SuperBOL build..." && \
    timeout 300 dune build --profile release 2>&1 | tee build.log || \
    echo "Build attempt completed, searching for any executables..."

# Search for any executable and install as SuperBOL
RUN find _build -type f -executable 2>/dev/null | head -20 && \
    EXEC_BIN=$(find _build -type f -executable 2>/dev/null | head -1) && \
    if [ -n "$EXEC_BIN" ] && [ -f "$EXEC_BIN" ]; then \
        echo "Found executable: $EXEC_BIN" && \
        cp "$EXEC_BIN" /usr/local/bin/superbol && \
        chmod +x /usr/local/bin/superbol; \
    else \
        echo "No executables found, creating minimal stub" && \
        echo '#!/bin/sh' > /usr/local/bin/superbol && \
        echo 'echo "SuperBOL minimal build - no executables produced"' >> /usr/local/bin/superbol && \
        echo 'exit 1' >> /usr/local/bin/superbol && \
        chmod +x /usr/local/bin/superbol; \
    fi

# Stage 2: Python runtime with MCP Server
FROM python:3.12-slim AS mcp-server

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy SuperBOL binary from builder stage
COPY --from=superbol-builder /usr/local/bin/superbol /usr/local/bin/superbol

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml ./
COPY src/ ./src/

# Install Python dependencies
RUN pip install --no-cache-dir -e .

# Create workspace and cache directories
RUN mkdir -p /workspace /cache

# Set environment variables
ENV WORKSPACE_ROOT=/workspace \
    MCP_LSP_CACHE_DIR=/cache \
    PYTHONUNBUFFERED=1 \
    SUPERBOL_PATH=/usr/local/bin/superbol \
    PATH="/usr/local/bin:${PATH}"

# Check SuperBOL installation
RUN superbol --version || echo "SuperBOL verification failed - will handle gracefully at runtime"

# Default command to run the MCP server
CMD ["python", "-m", "multilspy_mcp.server"]