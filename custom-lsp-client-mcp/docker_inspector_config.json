{
  "mcpServers": {
    "multilspy-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-v", "${PWD}/workspace:/workspace:ro",
        "-v", "/tmp/mcp-lsp-cache:/cache",
        "-e", "WORKSPACE_ROOT=/workspace",
        "-e", "MCP_LSP_CACHE_DIR=/cache",
        "-e", "LOG_LEVEL=DEBUG",
        "multilspy-mcp-server:latest",
        "python", "-m", "mcp", "run", "multilspy_mcp.server:mcp"
      ]
    }
  }
}