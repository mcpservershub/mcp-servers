# Multi-stage Dockerfile for MCP Server with SuperBOL COBOL support
# Uses Chainguard base for SuperBOL build, then copies to Python runtime

# Stage 1: Build SuperBOL using Chainguard
FROM cgr.dev/chainguard/wolfi-base:latest AS superbol-builder

# Install dependencies for SuperBOL build
RUN apk add --no-cache \
  git \
  make \
  curl \
  nodejs \
  npm \
  opam \
  gnucobol \
  gdb \
  gcc \
  posix-libc-utils \
  bubblewrap \
  python3 \
  py3-pip

# Initialize opam
RUN opam init --disable-sandboxing -y && \
  eval $(opam env)

# Build SuperBOL from source - simplified approach
WORKDIR /opt

# Clone SuperBOL source
RUN git clone https://github.com/ocamlpro/superbol-studio-oss.git
WORKDIR /opt/superbol-studio-oss

# Install essential build dependencies
RUN eval $(opam env) && \
    opam update && \
    opam install -y dune ocaml-lsp-server menhir ppx_deriving ppx_import yojson

# Try building just the LSP server part without full studio dependencies
RUN eval $(opam env) && \
    dune build --only-deps && \
    dune build src/lsp/ --profile release || \
    dune build src/cobol_lsp/ --profile release || \
    dune build bin/ --profile release || \
    echo "Build attempts completed, checking results"

# Look for any SuperBOL binary and install it
RUN eval $(opam env) && \
    echo "Searching for SuperBOL binaries..." && \
    find _build -name "*superbol*" -type f -executable | head -5 && \
    find _build -name "*lsp*" -type f -executable | grep -i cobol | head -5 && \
    SUPERBOL_BIN=$(find _build -name "*superbol*" -type f -executable | head -1) && \
    if [ -n "$SUPERBOL_BIN" ] && [ -f "$SUPERBOL_BIN" ]; then \
        echo "Found SuperBOL binary: $SUPERBOL_BIN" && \
        cp "$SUPERBOL_BIN" /usr/local/bin/superbol && \
        chmod +x /usr/local/bin/superbol; \
    else \
        echo "No SuperBOL binary found, checking for COBOL LSP..." && \
        COBOL_LSP_BIN=$(find _build -name "*lsp*" -type f -executable | grep -i cobol | head -1) && \
        if [ -n "$COBOL_LSP_BIN" ] && [ -f "$COBOL_LSP_BIN" ]; then \
            echo "Found COBOL LSP binary: $COBOL_LSP_BIN" && \
            cp "$COBOL_LSP_BIN" /usr/local/bin/superbol && \
            chmod +x /usr/local/bin/superbol; \
        else \
            echo "No SuperBOL/COBOL LSP binaries found, creating error binary" && \
            echo '#!/bin/sh' > /usr/local/bin/superbol && \
            echo 'echo "SuperBOL build failed - no binaries produced"' >> /usr/local/bin/superbol && \
            echo 'exit 1' >> /usr/local/bin/superbol && \
            chmod +x /usr/local/bin/superbol; \
        fi \
    fi

# Stage 2: Python runtime with MCP Server
FROM python:3.12-slim AS mcp-server

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
  wget \
  ca-certificates \
  gnucobol \
  git \
  && rm -rf /var/lib/apt/lists/*

# Copy SuperBOL binary from builder stage
COPY --from=superbol-builder /usr/local/bin/superbol /usr/local/bin/superbol

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml ./
COPY src/ ./src/

# Install Python dependencies
RUN pip install --no-cache-dir -e .

# Create workspace and cache directories
RUN mkdir -p /workspace /cache

# Set environment variables
ENV WORKSPACE_ROOT=/workspace \
  MCP_LSP_CACHE_DIR=/cache \
  PYTHONUNBUFFERED=1 \
  SUPERBOL_PATH=/usr/local/bin/superbol \
  PATH="/usr/local/bin:${PATH}"

# Verify SuperBOL installation
RUN superbol --version || echo "SuperBOL installation verification failed"

# Default command to run the MCP server
CMD ["python", "-m", "multilspy_mcp.server"]
