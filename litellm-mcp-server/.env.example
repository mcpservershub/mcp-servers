# LiteLLM MCP Server Configuration
# Copy this file to .env and fill in your API keys

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI Configuration
AZURE_API_KEY=...
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview

# Google AI Configuration
GOOGLE_API_KEY=...
# OR
GEMINI_API_KEY=...

# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION_NAME=us-east-1

# Cohere Configuration
COHERE_API_KEY=...

# Hugging Face Configuration
HUGGINGFACE_API_KEY=...

# Replicate Configuration
REPLICATE_API_KEY=...

# Together AI Configuration
TOGETHERAI_API_KEY=...

# Mistral AI Configuration
MISTRAL_API_KEY=...

# Groq Configuration
GROQ_API_KEY=...

# Perplexity Configuration
PERPLEXITYAI_API_KEY=...

# DeepInfra Configuration
DEEPINFRA_API_KEY=...

# Optional: Default Configuration
LITELLM_DEFAULT_MODEL=gpt-3.5-turbo
LITELLM_DEFAULT_TEMPERATURE=0.7
LITELLM_DEFAULT_MAX_TOKENS=2000
LITELLM_DEFAULT_TIMEOUT=30

# Optional: Router Configuration
LITELLM_ENABLE_FALLBACK=true
LITELLM_ROUTING_STRATEGY=cost-optimized

# Optional: Budget Configuration
LITELLM_ENABLE_BUDGET_TRACKING=true
LITELLM_DAILY_BUDGET_LIMIT=10.0
LITELLM_ALERT_THRESHOLD=0.8

# Optional: Cache Configuration
LITELLM_ENABLE_CACHE=true
LITELLM_CACHE_TTL=3600

# Optional: Logging Configuration
LITELLM_LOG_LEVEL=INFO
LITELLM_LOG_REQUESTS=true