# MCP server with SuperBOL COBOL support
FROM python:3.12-slim

# Install system dependencies for COBOL support
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    gnucobol \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Note: SuperBOL will be installed externally or built separately
# The MCP server will gracefully handle when SuperBOL is not available

# Copy project files
COPY pyproject.toml ./
COPY src/ ./src/

# Install Python dependencies
RUN pip install --no-cache-dir -e .

# Create workspace and cache directories
RUN mkdir -p /workspace /cache

# Set environment variables
ENV WORKSPACE_ROOT=/workspace \
    MCP_LSP_CACHE_DIR=/cache \
    PYTHONUNBUFFERED=1 \
    SUPERBOL_PATH=/usr/local/bin/superbol \
    PATH="/usr/local/bin:${PATH}"

# Health check to verify SuperBOL installation
RUN superbol --version || echo "SuperBOL installation verification failed"

# Default command to run the MCP server
CMD ["python", "-m", "multilspy_mcp.server"]