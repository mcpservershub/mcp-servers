# Spec-Kit MCP Server Environment Variables

# Repository Settings
SPEC_KIT_REPO_PATH=/workspace
SPEC_KIT_DEFAULT_AI=claude

# GitHub Settings (for template downloads)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=github
GITHUB_REPO_NAME=spec-kit

# Performance Settings
SPEC_KIT_MAX_CONCURRENT_OPERATIONS=5
SPEC_KIT_SCRIPT_TIMEOUT=30

# Security Settings
SPEC_KIT_RESTRICT_TO_REPO=true

# Logging
LOG_LEVEL=INFO